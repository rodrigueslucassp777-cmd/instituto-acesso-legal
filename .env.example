SECRET_KEY=troque-esta-chave-em-producao
# Padrão seguro para produção. Em desenvolvimento local, troque para True.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Hardening aplicado automaticamente quando DEBUG=False (ver config/settings.py).
# SECURE_SSL_REDIRECT só deve ser True se o servidor realmente atender HTTPS
# diretamente (sem proxy/load balancer fazendo esse papel antes).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600

# Use DB_ENGINE=postgres para usar PostgreSQL; qualquer outro valor (ou ausente) usa SQLite local.
DB_ENGINE=sqlite
DB_NAME=instituto_acesso_legal
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
